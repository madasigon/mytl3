{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build (g++)",
            "command": "/opt/homebrew/bin/g++-15",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-Isrc",
                "-Iunit_test/files",
                "-O0",
                "-g",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wconversion",
                "-Wsign-conversion",
                "-D_GLIBCXX_DEBUG",
                "-D_GLIBCXX_DEBUG_PEDANTIC",
                "-U_FORTIFY_SOURCE",
                "-D_FORTIFY_SOURCE=2",
                "-fstack-protector",
                "-Wformat=2",
                "-Wfloat-equal",
                "-Wcast-qual",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "inject & build current file (g++)",
            "dependsOn": [
                "inject current file",
                "build (g++)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc"
        },
        {
            "label": "inject",
            "type": "shell",
            "command": "uv run mytl-util inject",
            "problemMatcher": []
        },
        {
            "label": "test-inject",
            "type": "shell",
            "command": "uv run mytl-util test-inject",
            "problemMatcher": []
        },
        {
            "label": "inject current file",
            "type": "shell",
            "command": "uv run mytl-util inject ${file}",
            "problemMatcher": []
        }
    ]
}
