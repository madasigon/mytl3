{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: configure"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: run tests",
            "type": "shell",
            "command": "cd build && ctest --verbose",
            "group": "test",
            "dependsOn": [
                "CMake: build"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Debug",
                "--target",
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
} 