FROM ubuntu:latest

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Install basic dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    build-essential \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.25.7
RUN wget https://go.dev/dl/go1.25.7.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.25.7.linux-amd64.tar.gz && \
    rm go1.25.7.linux-amd64.tar.gz

# Set Go environment variables
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/root/go"
ENV PATH="${GOPATH}/bin:${PATH}"

# Install Node.js 20.x (includes npm)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install mcp-chrome-bridge using npm (simpler and more reliable in Docker)
RUN npm install -g mcp-chrome-bridge

# Clone and build cf-tool
WORKDIR /opt
RUN git clone https://github.com/NetWilliam/cf-tool.git && \
    cd cf-tool && \
    make build && \
    cp bin/cf /usr/local/bin/cf && \
    chmod +x /usr/local/bin/cf

# Create a working directory for user code
WORKDIR /workspace

# Verify installations
RUN go version && \
    node --version && \
    npm --version && \
    cf --version

RUN mcp-chrome-bridge register
# Start mcp-chrome-bridge in the background and keep container running
# Bind to 0.0.0.0 so it's accessible from host
