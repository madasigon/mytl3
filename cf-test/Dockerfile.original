FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Download ORIGINAL xalanq cf-tool (even though archived)
RUN wget https://github.com/xalanq/cf-tool/releases/download/v1.0.0/cf_1.0.0_linux_amd64.tar.gz -O /tmp/cf.tar.gz && \
    tar -xzf /tmp/cf.tar.gz -C /usr/local/bin/ && \
    chmod +x /usr/local/bin/cf && \
    rm /tmp/cf.tar.gz

# Create config directory
RUN mkdir -p /root/.config/cf

WORKDIR /workspace

CMD ["/bin/bash"]


